{
  "name": "psyscripts",
  "version": "2.1.0",
  "description": "Lightweight dependency-free scripts for web developers — 31 scripts with a full configuration API",
  "license": "MIT",
  "author": "PsyGioX",
  "homepage": "https://psyscripts.vercel.app",
  "repository": "github:PsyGioX/psyscripts",
  "scripts": {
    "build": "node scripts/build.js",
    "icons": "node scripts/icons.js",
    "serve": "npx serve .",
    "docs": "python3 scripts/docs-data.py",
    "locales": "python3 scripts/locales-site.py && python3 scripts/locales-v21.py",
    "fonts": "node scripts/fonts.js",
    "favicon": "python3 scripts/favicon.py",
    "test": "node --test tests/*.test.js",
    "audit": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@mdi/font": "^7.4.47",
    "@tabler/icons-webfont": "^3.30.0",
    "bootstrap-icons": "^1.11.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  }
}
